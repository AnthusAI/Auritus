direction: right

vars: {
  d2-config: {
    pad: 32
    theme-overrides: {
      N1: "#21180f"
      N2: "#665846"
      N3: "#9a8668"
      N4: "#cdbfa8"
      N5: "#e6dcc9"
      N6: "#f5eedf"
      N7: "#fbf5e8"
      B1: "#482015"
      B2: "#943c2e"
      B3: "#b8614e"
      B4: "#d99a80"
      B5: "#efcbbb"
      B6: "#fae8de"
      AA2: "#6e4f2b"
      AA4: "#b88e4c"
      AA5: "#e5c88f"
      AB4: "#b87925"
      AB5: "#f2d8a4"
    }
    dark-theme-overrides: {
      N1: "#f3e6cf"
      N2: "#cfbea4"
      N3: "#a99273"
      N4: "#705c44"
      N5: "#4a3928"
      N6: "#2d231b"
      N7: "#1a1410"
      B1: "#f3d3c1"
      B2: "#e19a78"
      B3: "#bd7258"
      B4: "#704132"
      B5: "#482c22"
      B6: "#301e18"
      AA2: "#d7b57a"
      AA4: "#926e39"
      AA5: "#4f3920"
      AB4: "#efb85d"
      AB5: "#5c401f"
    }
  }
}

reader: {
  label: "Reader"
  shape: person
}

publisher: {
  label: "Publisher page\none script tag"
  shape: page
}

auritus: {
  label: "Auritus"

  extract: "Extract readable content\nand create a content hash"
  request: "Request audio\nwith the site key"
  player: "Private signed URL\nand accessible player"
}

local: {
  label: "Your hardware"
  worker: "Local GPU worker\nOpen TTS model"
}

aws: {
  label: "Your AWS account"

  api: "Private job API\nand job mutex"
  fallback: "Cloud GPU fallback\nonly when needed"
  audio: "Private audio\nshort-lived access"
}

models: {
  label: "Choose and tune\nthe model"
  shape: hexagon
}

reader -> publisher: "opens an article"
publisher -> auritus.extract: "embed loads"
auritus.extract -> auritus.request
auritus.request -> local.worker: "local path first"
local.worker -> models
local.worker -> aws.audio: "upload result"
auritus.request -> aws.api
aws.api -> aws.fallback: "wait only if unclaimed"
aws.fallback -> models
aws.fallback -> aws.audio
aws.audio -> auritus.player: "signed audio URL"
auritus.player -> reader: "listen"
