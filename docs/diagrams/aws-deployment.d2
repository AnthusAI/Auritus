direction: right

vars: {
  d2-config: {
    pad: 32
    theme-overrides: {
      N1: "#21180f"
      N2: "#665846"
      N3: "#9a8668"
      N4: "#cdbfa8"
      N5: "#e6dcc9"
      N6: "#f5eedf"
      N7: "#fbf5e8"
      B1: "#482015"
      B2: "#943c2e"
      B3: "#b8614e"
      B4: "#d99a80"
      B5: "#efcbbb"
      B6: "#fae8de"
      AA2: "#6e4f2b"
      AA4: "#b88e4c"
      AA5: "#e5c88f"
      AB4: "#b87925"
      AB5: "#f2d8a4"
    }
    dark-theme-overrides: {
      N1: "#f3e6cf"
      N2: "#cfbea4"
      N3: "#a99273"
      N4: "#705c44"
      N5: "#4a3928"
      N6: "#2d231b"
      N7: "#1a1410"
      B1: "#f3d3c1"
      B2: "#e19a78"
      B3: "#bd7258"
      B4: "#704132"
      B5: "#482c22"
      B6: "#301e18"
      AA2: "#d7b57a"
      AA4: "#926e39"
      AA5: "#4f3920"
      AB4: "#efb85d"
      AB5: "#5c401f"
    }
  }
}

site: {
  label: "Publisher origin"
}

aws: {
  label: "Customer AWS account"

  api: {
    label: "HTTP API + router"
  }
  jobs: {
    label: "Job and site tables\nconditional claim mutex"
  }
  workflow: {
    label: "Fallback workflow"
  }
  batch: {
    label: "GPU fallback\nopen-model worker"
  }
  audio: {
    label: "Private audio"
  }
  edge: {
    label: "Short-lived playback URL"
  }
  controls: {
    label: "Quota, budget,\nand kill switch"
    shape: hexagon
  }
}

local: {
  label: "Optional local GPU"
  worker: "Claims first,\nsynthesizes locally"
}

site -> aws.api: "site key + origin"
aws.api -> aws.jobs: "create / claim / status"
aws.api -> aws.workflow: "start fallback timer"
local.worker -> aws.api: "claim job"
local.worker -> aws.audio: "upload audio"
aws.workflow -> aws.jobs: "still pending?"
aws.workflow -> aws.batch: "only if unclaimed"
aws.batch -> aws.api: "claim, upload, complete"
aws.batch -> aws.audio
aws.api -> aws.edge
aws.edge -> site: "signed URL"
aws.controls -> aws.batch: "can disable"
aws.controls -> aws.api: "enforces limits"
