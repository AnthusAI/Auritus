  d2-config: {
    pad: 32
    theme-overrides: {
      N1: "#21180f"
      N2: "#665846"
      N3: "#9a8668"
      N4: "#cdbfa8"
      N5: "#e6dcc9"
      N6: "#f5eedf"
      N7: "#fbf5e8"
      B1: "#482015"
      B2: "#943c2e"
      B3: "#b8614e"
      B4: "#d99a80"
      B5: "#efcbbb"
      B6: "#fae8de"
      AA2: "#6e4f2b"
      AA4: "#b88e4c"
      AA5: "#e5c88f"
      AB4: "#b87925"
      AB5: "#f2d8a4"
    }
    dark-theme-overrides: {
      N1: "#f3e6cf"
      N2: "#cfbea4"
      N3: "#a99273"
      N4: "#705c44"
      N5: "#4a3928"
      N6: "#382b21"
      N7: "#2d231b"
      B1: "#f3d3c1"
      B2: "#e19a78"
      B3: "#bd7258"
      B4: "#704132"
      B5: "#482c22"
      B6: "#301e18"
      AA2: "#d7b57a"
      AA4: "#926e39"
      AA5: "#4f3920"
      AB4: "#efb85d"
      AB5: "#5c401f"
    }
  }
}

conventional: {
  label: "Conventional: an IAM access key on the worker machine"

  key: {
    label: "AKIA... + secret\nstatic, no expiry"
    shape: page
  }
  scope: {
    label: "Scope is a policy you wrote\noften broader than intended\nand it drifts over time"
  }
  rot: {
    label: "Rotation is a calendar chore\nskipped under load"
  }
  leak: {
    label: "If it leaks\nAWS API access\nuntil a human notices"
    style.bold: true
  }
  key -> scope -> rot -> leak
}

auritus: {
  label: "Auritus: a short-lived, API-scoped JWT"

  tok: {
    label: "Cognito access token\nexpires in 1 hour"
    shape: page
  }
  scope2: {
    label: "Cannot call AWS APIs at all\nonly Auritus operator routes\nscope is structural, not a policy"
  }
  rot2: {
    label: "Rotation is automatic\nevery refresh, no calendar"
  }
  leak2: {
    label: "If it leaks\nat most 1 hour\nrevocable with auritus logout"
    style.bold: true
  }
  tok -> scope2 -> rot2 -> leak2
}

risk: {
  label: "The risk is removed by the architecture,\nnot by remembering to manage keys"
  shape: text
  style.font-size: 24
  style.bold: true
}

conventional.leak -> risk {style.stroke-dash: 3}
auritus.leak2 -> risk {style.stroke-dash: 3}
