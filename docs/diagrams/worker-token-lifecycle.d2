direction: right

vars: {
  d2-config: {
    pad: 32
    theme-overrides: {
      N1: "#21180f"
      N2: "#665846"
      N3: "#9a8668"
      N4: "#cdbfa8"
      N5: "#e6dcc9"
      N6: "#f5eedf"
      N7: "#fbf5e8"
      B1: "#482015"
      B2: "#943c2e"
      B3: "#b8614e"
      B4: "#d99a80"
      B5: "#efcbbb"
      B6: "#fae8de"
      AA2: "#6e4f2b"
      AA4: "#b88e4c"
      AA5: "#e5c88f"
      AB4: "#b87925"
      AB5: "#f2d8a4"
    }
    dark-theme-overrides: {
      N1: "#f3e6cf"
      N2: "#cfbea4"
      N3: "#a99273"
      N4: "#705c44"
      N5: "#4a3928"
      N6: "#382b21"
      N7: "#2d231b"
      B1: "#f3d3c1"
      B2: "#e19a78"
      B3: "#bd7258"
      B4: "#704132"
      B5: "#482c22"
      B6: "#301e18"
      AA2: "#d7b57a"
      AA4: "#926e39"
      AA5: "#4f3920"
      AB4: "#efb85d"
      AB5: "#5c401f"
    }
  }
}

once: {
  label: "Once, with a human present"

  login: {
    label: "auritus login\nCognito email + password\nor federated sign-in"
    shape: oval
    style.bold: true
  }
  issued: {
    label: "Cognito issues a pair\naccess token  1 hour\nrefresh token  30 days"
    shape: page
  }
  login -> issued
}

steady: {
  label: "Steady state: no human, indefinitely"

  work: {
    label: "Worker calls the API\nBearer access token"
  }
  refresh: {
    label: "Silent refresh\nbefore the hour is up"
    shape: hexagon
    style.bold: true
  }
  rotate: {
    label: "Rotation\nnew refresh token issued\n30-day clock resets"
    style.bold: true
  }
  work -> refresh: "token near expiry"
  refresh -> rotate: "grant_type=\nrefresh_token"
  rotate -> work: "repeat" {style.bold: true}
}

lapse: {
  label: "Only if the worker goes quiet"

  warn: {
    label: "48h before expiry\nemail the operator"
  }
  dead: {
    label: "Past 30 days idle\nrefresh rejected\nworker stops"
  }
  warn -> dead: "still idle" {style.stroke-dash: 3}
}

once.issued -> steady.work: "first call" {style.bold: true}
steady.refresh -> lapse.warn: "nearing 30 days" {style.stroke-dash: 3}
lapse.dead -> once.login: "re-login required" {style.stroke-dash: 3}
